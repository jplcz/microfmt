template <>
struct microfmt::${3:some_provider}_traits<${1:your_provider}_tag> {
  using context_type = ${1:your_provider}_context;

  // Read-only operation: value_ref<const context_type>.
  static bool ${4:operation}(microfmt::value_ref<const context_type> context,
                        ${5:/* ... operation-specific parameters ... */}) noexcept {
    // ... implement using context->... ...
    return true;
