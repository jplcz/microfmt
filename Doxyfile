PROJECT_NAME           = microfmt
PROJECT_BRIEF          = Zero-allocation C++ formatting for constrained environments
OUTPUT_DIRECTORY       = build
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English
OPTIMIZE_OUTPUT_FOR_C  = NO
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
RECURSIVE              = YES
INPUT                  = include README.md
FILE_PATTERNS          = *.hpp *.md
USE_MDFILE_AS_MAINPAGE = README.md
GENERATE_HTML          = YES
HTML_OUTPUT            = docs/html
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
GENERATE_XML           = NO
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_AS_ERROR          = NO
